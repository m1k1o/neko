#!/bin/sh
#
# Usage: chromium-unlock <user-data-dir>
#
# Chromium based browsers lock their profile with a SingletonLock symlink that
# points to "<hostname>-<pid>". A recreated container gets a new hostname, so a
# lock left in a persisted profile makes the browser refuse to start, as the
# profile seems to be in use on another computer. Remove the lock when it is
# stale. Runs once from supervisord, before the browser is started.
#
# A lock from another hostname is treated as stale, so do not share one profile
# between containers that run at the same time.

dir="$1"

lock="$dir/SingletonLock"
if [ -L "$lock" ]; then
  target="$(readlink "$lock")"
  host="${target%-*}"
  pid="${target##*-}"

  if [ "$host" != "$(uname -n)" ] || ! kill -0 "$pid" 2>/dev/null; then
    echo "chromium-unlock: removing stale lock $lock -> $target"
    rm -f "$dir/SingletonLock" "$dir/SingletonSocket" "$dir/SingletonCookie"
  fi
fi

exit 0
