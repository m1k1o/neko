#!/bin/sh

# GStreamer only registers the VA-API elements (e.g. vah264enc) if a usable VA
# display is found while the plugins are scanned for the first time. The result
# of that scan is cached in the user's registry, so if it happens before the X
# server is up, the elements stay missing from the cache and every client
# connect fails with '(pipeline error) no element "vah264enc"'.
#
# Wait until VA is usable through X, then drop any stale registry, so that the
# first scan of this process happens with a working VA display.
if command -v vainfo >/dev/null 2>&1; then
  i=0
  while [ "$i" -lt 30 ]; do
    if vainfo >/dev/null 2>&1; then break; fi
    sleep 1
    i=$((i + 1))
  done

  rm -f "$HOME/.cache/gstreamer-1.0/registry."*
fi

exec /usr/bin/neko serve "$@"
