{
  "name": "neko-client",
  "version": "3.0.0",
  "private": true,
  "description": "Client for neko: React GUI + framework-free core on the v3 API.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "node e2e.mjs",
    "test:store": "node src/core/store.check.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit && prettier --check . && eslint src && node src/core/store.check.ts && node src/core/client.check.ts && node src/app/markdown.check.ts",
    "build:emoji": "node tools/emoji.ts && prettier --write src/assets/styles/vendor/_emoji.scss"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "emoji-datasource": "6.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "emojilib": "3.0.8",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "sass": "^1.89.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0"
  }
}
