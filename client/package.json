{
  "name": "neko-client",
  "version": "3.0.0",
  "private": true,
  "description": "Client for neko: React GUI + framework-free core on the v3 API.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/dist.check.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit && prettier --check . && eslint src core/src && node tools/cycles.mjs && npm test && npm run build:core && node core/dist.check.mjs",
    "build:emoji": "node tools/emoji.ts",
    "build:core": "npm --prefix core run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.54.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.16",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "emoji-datasource": "^6.1.1",
    "emojilib": "3.0.8",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
